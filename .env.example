# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Frontend URL (for reset links)
FRONTEND_URL=http://localhost:5173/

# Email Configuration
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=support@dtfindia.org
SMTP_PASSWORD=your_secure_password_here
SMTP_FROM_NAME=Team DTF
SMTP_FROM_EMAIL=support@dtfindia.org

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRY=7d

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRY=15m
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_LOCK_TIME=3600000 # 1 hour in ms

# Rate Limiting
RATE_LIMIT_WINDOW=900000 # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=5

# Node Environment
NODE_ENV=production
PORT=5000

# Logging
LOG_LEVEL=info
